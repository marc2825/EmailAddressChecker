EMAILCHECK_PROFILE=local-passive
EMAILCHECK_LOG_LEVEL=INFO
EMAILCHECK_ACTIVE_PROBES_ENABLED=false
EMAILCHECK_DATABASE_URL=sqlite:///./emailcheck.sqlite3
EMAILCHECK_REDIS_URL=redis://localhost:6379/0
EMAILCHECK_SENDER_HELO=probe.example.invalid
EMAILCHECK_SENDER_ADDRESS=probe@example.invalid
EMAILCHECK_HMAC_KEY=replace-with-at-least-32-random-bytes
EMAILCHECK_RAW_EVIDENCE_KEY=replace-with-a-separate-encryption-key
